{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "chrome",
      "type": "block",
      "content": {
        "mod": "mavericks",
        "props": {
          "role": "chrome"
        }
      },
      "size": {
        "px": 40
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "mavericks-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "mavericks-agents"
              }
            }
          ],
          "size": {
            "px": 220
          },
          "min": 180,
          "max": 420
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "mavericks",
                "props": {
                  "role": "tabs"
                }
              },
              "size": {
                "px": 33
              }
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "mavericks",
                      "props": {
                        "role": "pane"
                      }
                    },
                    "reveal": "always",
                    "height": 24,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "#b8b8b8"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#9a9a9a"
                  },
                  "radius": 0,
                  "gap": 1,
                  "lone": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "content": {
        "mod": "mavericks",
        "props": {
          "role": "status"
        }
      },
      "size": {
        "px": 22
      }
    }
  ],
  "background": "#e9e9e9",
  "theme": "mavericks",
  "font": "Menlo",
  "font_size": 12,
  "ui_font": "Helvetica Neue",
  "titlebar": "none",
  "traffic_lights": [
    12,
    13
  ]
}