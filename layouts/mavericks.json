{
  "id": "root",
  "type": "column",
  "theme": {
    "light": "mavericks",
    "dark": "mavericks-dark"
  },
  "font": "Menlo",
  "font_size": 12,
  "ui_font": "Helvetica Neue",
  "titlebar": "none",
  "traffic_lights": [
    12,
    13
  ],
  "background": "#e9e9e9",
  "children": [
    {
      "id": "chrome",
      "type": "block",
      "size": {
        "px": 40
      },
      "content": {
        "mod": "mavericks",
        "props": {
          "role": "chrome"
        }
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 220
          },
          "min": 180,
          "max": 420,
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "mavericks-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "mavericks-agents"
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 1,
                  "radius": 0,
                  "background": "background",
                  "border": {
                    "width": 0,
                    "color": "#b8b8b8"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#9a9a9a"
                  },
                  "header": {
                    "content": {
                      "mod": "mavericks",
                      "props": {
                        "role": "pane"
                      }
                    },
                    "height": 24,
                    "position": "top",
                    "reveal": "always"
                  },
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "size": {
                "px": 300
              },
              "min": 220,
              "max": 560,
              "hidden": true,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "mavericks-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "mavericks-changes"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "background": "#b8b8b8",
          "gap": 1
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 22
      },
      "content": {
        "mod": "mavericks",
        "props": {
          "role": "status"
        }
      }
    }
  ]
}